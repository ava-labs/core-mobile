                <mxCell id="5Swap_c_10" value="(f) Avalanche CCT / CCIP — cross-chain&lt;br&gt;transfer of supported tokens" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7C2D12;strokeColor=#FB923C;fontColor=#FFFFFF;" parent="1" vertex="1">
