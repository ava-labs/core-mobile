                </mxCell>
                <mxCell id="2Receive_e_23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="2Receive_c_12" target="2Receive_c_13" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="2Receive_e_24" value="credited to the&lt;br&gt;user&#39;s address" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#FB923C;strokeWidth=3;fontColor=#FDBA74;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" parent="1" source="2Receive_c_9" target="2Receive_c_12" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="2Receive_c_26" value="Receiving needs only the PUBLIC address.&lt;br&gt;The corresponding private key stays wherever&lt;br&gt;onboarding put it and is never touched." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="354" y="604.8" width="280" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="2Receive_c_37" value="(i) PARTIES: user; Core Mobile app; Ava Labs backend (Glacier indexer, push notifications); the external sender; the blockchain network.&lt;br&gt;(ii) FLOW OF FUNDS: one direction only — from the sender&#39;s address to an address the user controls. Applies identically to native coins, stablecoins (e.g. USDC), other ERC-20s and NFTs. No fiat is involved. The asset never passes through an Ava Labs account.&lt;br&gt;(iii) CUSTODY: non-custodial throughout. Only the public address is disclosed. Core cannot refuse, reverse, or intercept an inbound transfer.&lt;br&gt;(iv) THIRD PARTIES: Glacier (Ava Labs&#39; own indexer) reads public chain data; Firebase delivers the notification. Neither can move funds.&lt;br&gt;(v) FEES: Core charges nothing to receive. The SENDER pays the network fee. The recipient pays no fee on any supported chain." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#0B2545;strokeColor=#64748B;fontColor=#E2E8F0;fontFamily=Verdana;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1231.6" width="1500" height="200" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
