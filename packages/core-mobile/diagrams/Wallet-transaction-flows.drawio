                    <mxGeometry x="970" y="144" width="296" height="2036" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_65" value="Validator &amp; Core fee escrow" style="rounded=0;html=1;fillColor=#0B2A5B;strokeColor=#1E3A6B;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
                    <mxGeometry x="970" y="144" width="296" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_66" value="" style="rounded=0;html=1;fillColor=#071E4A;strokeColor=#1E3A6B;opacity=60;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="144" width="296" height="2036" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_67" value="Avalanche C-Chain / P-Chain" style="rounded=0;html=1;fillColor=#0B2A5B;strokeColor=#1E3A6B;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=12;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="144" width="296" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_1" value="6. Stake / Earn — P-Chain delegation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_2" value="Delegation needs AVAX on the P-Chain, so funding from the C-Chain adds two atomic cross-chain transactions before the stake itself. Claiming at the end adds two more — and EVERY leg is signed separately.&lt;br&gt;A Core fee is charged on the Fast Stake path only; the advanced delegate path charges none." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1500" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_3" value="Open Stake" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#E2E8F0;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="88" y="190" width="200" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_4" value="Fast Stake or&lt;br&gt;Advanced?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#FBBF24;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="378" y="270" width="240" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_5" value="Fast Stake: Glacier auto-selects a&lt;br&gt;validator — uptime &gt;= 98%, delegation&lt;br&gt;fee &lt;= 2%, spare capacity, and enough&lt;br&gt;time left to cover the duration" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#164E63;strokeColor=#22D3EE;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="677" y="360" width="262" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_6" value="Advanced: user browses and filters&lt;br&gt;validator nodes and picks one" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="57" y="360" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_7" value="Enter stake amount and duration" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="57" y="460" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_8" value="computeDelegationSteps: is the AVAX&lt;br&gt;already on the P-Chain?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#FBBF24;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="373" y="540" width="250" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_9" value="Feature flag variant&lt;br&gt;carries the rate in basis points —&lt;br&gt;no variant means no fee" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#164E63;strokeColor=#22D3EE;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="679" y="638" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_10" value="(f) FAST STAKE ONLY — fee policy:&lt;br&gt;rate x NET reward, applied AFTER&lt;br&gt;the validator&#39;s own fee" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="638" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_11" value="ADVANCED PATH: no Core fee is charged.&lt;br&gt;A separate delegate-fee flag exists in&lt;br&gt;the code but is not enabled" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="730" width="262" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_12" value="(k) Approve and sign EACH funding step&lt;br&gt;separately — Ledger and Keystone&lt;br&gt;require per-step confirmation" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="57" y="810" width="262" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_13" value="(k) WalletService signs each step" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7F1D1D;strokeColor=#F87171;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="900" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_14" value="(f) Step 1 — exportC: atomic transaction&lt;br&gt;moves AVAX off the C-Chain" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1299" y="898" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_15" value="(f) Step 2 — importP: atomic transaction&lt;br&gt;credits the P-Chain" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1299" y="988" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_16" value="(f) Step 3 — delegate: addDelegator&lt;br&gt;transaction on the P-Chain" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1299" y="1078" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_17" value="(f) FAST STAKE ONLY: a Core-owned P-Chain&lt;br&gt;escrow receives the convenience fee as a&lt;br&gt;UTXO output bundled with the delegation" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7C2D12;strokeColor=#FB923C;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="987" y="1170" width="262" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_18" value="(f) Validator node takes its own&lt;br&gt;delegation fee (commission) from&lt;br&gt;the rewards it earns" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7C2D12;strokeColor=#FB923C;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="987" y="1284" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_19" value="Stake ACTIVE — AVAX locked in the&lt;br&gt;protocol for the chosen duration.&lt;br&gt;Not held by Core or the validator" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1297" y="1337" width="262" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_20" value="Rewards accrue; stake tracked in&lt;br&gt;the Stakes list via Glacier" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="1460" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_21" value="Claim at the end of the term" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="57" y="1550" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_22" value="(k) Approve and sign the claim —&lt;br&gt;TWO separate signatures (exportP then&lt;br&gt;importC); Ledger confirms each in turn" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="57" y="1640" width="262" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_23" value="(k) WalletService signs exportP,&lt;br&gt;then signs importC" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7F1D1D;strokeColor=#F87171;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="1730" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_24" value="(f) exportP: atomic transaction moves the&lt;br&gt;stake and rewards off the P-Chain" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="1297" y="1820" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_25" value="(f) importC: atomic transaction credits&lt;br&gt;the C-Chain" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="1297" y="1910" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_26" value="importAnyStuckFunds offers recovery if&lt;br&gt;an atomic step was interrupted" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" vertex="1" parent="1">
                    <mxGeometry x="367" y="2000" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="6StakeEarn_c_27" value="Stake + rewards&lt;br&gt;back on C-Chain" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#E2E8F0;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=11;strokeWidth=3;" vertex="1" parent="1">
