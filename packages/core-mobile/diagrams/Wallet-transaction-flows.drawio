                <mxCell id="1Onboarding_e_68" value="consent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="1Onboarding_c_63" target="1Onboarding_c_67" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="1Onboarding_c_69" value="(i) PARTIES: user; Core Mobile app; Ava Labs backend (terms document, core-seedless-api); third parties (Google/Apple OIDC, CubeSigner/Cubist Labs, PostHog); no blockchain interaction.&lt;br&gt;(ii) FLOW OF FUNDS: none. No fiat, stablecoin, or other digital asset moves during onboarding.&lt;br&gt;(iii) CUSTODY: four distinct models — see the per-column notes. Only the seedless model places key material with a third party.&lt;br&gt;(iv) THIRD PARTIES: Google / Apple (identity only), CubeSigner (key generation, storage, remote signing), PostHog (analytics, only with consent).&lt;br&gt;(v) FEES: none. Onboarding is free and involves no network transaction." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#0B2545;strokeColor=#64748B;fontColor=#E2E8F0;fontFamily=Verdana;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="41" y="1229" width="1500" height="190" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
