                <mxCell id="5Swap_c_1" value="5. Swap — crypto to crypto, same-chain and cross-chain" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="5Swap_c_2" value="Routed by the Fusion SDK across several independent venues. Same-chain swaps settle in one transaction; cross-chain swaps hand the asset to a bridge contract in flight, which is the one point in any flow where the user does not directly control the asset." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1500" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="5Swap_c_3" value="Open Swap" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#E2E8F0;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="88" y="200" width="200" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="5Swap_c_4" value="Select the asset to swap from&lt;br&gt;and the asset to receive&lt;br&gt;(may be on a different chain)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
