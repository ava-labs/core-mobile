                <mxCell id="3Send_c_2" value="Five chain-specific paths share one approval and signing pipeline. Core builds and broadcasts the transaction but never takes possession of the asset." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
