                <mxCell id="3Send_c_4" value="Select asset to send&lt;br&gt;(native, ERC-20, stablecoin, NFT)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
