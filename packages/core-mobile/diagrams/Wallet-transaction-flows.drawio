                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8Offrampfiatofframp_e_34" value="crypto" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#FB923C;strokeWidth=3;fontColor=#FDBA74;" parent="1" source="8Offrampfiatofframp_c_16" target="8Offrampfiatofframp_c_17" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8Offrampfiatofframp_e_35" value="transaction status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="8Offrampfiatofframp_c_17" target="8Offrampfiatofframp_c_18" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8Offrampfiatofframp_e_36" value="fiat paid out to&lt;br&gt;the user&#39;s bank" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#22C55E;strokeWidth=3;dashed=1;fontColor=#4ADE80;exitX=0;exitY=1;entryX=1;entryY=0.5;" parent="1" source="8Offrampfiatofframp_c_17" target="8Offrampfiatofframp_c_20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8Offrampfiatofframp_e_37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="8Offrampfiatofframp_c_18" target="8Offrampfiatofframp_c_19" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8Offrampfiatofframp_e_38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="8Offrampfiatofframp_c_19" target="8Offrampfiatofframp_c_20" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="8Offrampfiatofframp_c_39" value="  ! Counterparty exposure window" style="rounded=1;html=1;fillColor=none;strokeColor=#FDE047;dashed=1;strokeWidth=3;verticalAlign=top;align=left;fontColor=#FEF08A;fontFamily=Verdana;fontSize=11;spacingLeft=8;spacingTop=2;dashPattern=4 4;" parent="1" vertex="1">
                    <mxGeometry x="1270" y="1179" width="296" height="116" as="geometry"/>
                </mxCell>
                <mxCell id="8Offrampfiatofframp_c_50" value="(i) PARTIES: user; Core Mobile app; Ava Labs backend (the Core proxy brokering all Meld traffic); Meld as aggregator; the licensed provider that buys the asset and pays out the fiat; the user&#39;s receiving bank; the blockchain network.&lt;br&gt;(ii) FLOW OF FUNDS: the reverse of Buy, again in two legs that never meet inside Core. The CRYPTO leg runs from the user&#39;s own address on-chain to a deposit address controlled by the provider. The FIAT leg then runs from the provider to the user&#39;s bank account or card and stays entirely within the provider&#39;s regulated environment — no fiat passes through an Ava Labs or Core-controlled account. Sellable assets include native coins (AVAX), BTC, and stablecoins (USDC).&lt;br&gt;(iii) CUSTODY — materially different from every other flow and worth stating plainly. Core remains non-custodial and never holds either leg. However, to complete a sale the customer must transfer their crypto to an address controlled by the PROVIDER, and they hold neither the crypto nor the fiat during the interval between that transfer and the payout. That interval is a genuine counterparty exposure to the provider, and it has no equivalent in the Buy flow (where the provider delivers to the customer). Core cannot reverse the on-chain transfer or compel the payout.&lt;br&gt;(iv) THIRD PARTIES: Meld (aggregation, sell quoting, session creation, transaction lookup) receives the wallet address, amount and currency pair. The selected provider additionally receives full KYC identity and the customer&#39;s BANK ACCOUNT or payout details, collected in its own hosted widget and never seen by the app. KYC, sanctions screening, and any source-of-funds checks are performed by the provider, not by Core.&lt;br&gt;(v) FEES: Meld&#39;s transaction record itemises networkFee, transactionFee, partnerFee and totalFee, so the fee structure is explicit here — a provider transaction fee, a partner fee, the on-chain network fee for sending the asset to the provider, and the FX spread embedded in the quoted payout rate. The user&#39;s own bank may also charge to receive the funds. Whether the partnerFee accrues to Ava Labs is a commercial arrangement that is NOT determinable from the client code and must be confirmed from the Meld contract." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#0B2545;strokeColor=#64748B;fontColor=#E2E8F0;fontFamily=Verdana;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1680" width="1500" height="310" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
