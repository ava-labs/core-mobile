                <mxCell id="8Offrampfiatofframp_e_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="8Offrampfiatofframp_c_12" target="8Offrampfiatofframp_c_13" edge="1">
