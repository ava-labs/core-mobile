<mxfile host="65bd71144e">
    <diagram id="pg_Legend_and_Parties" name="Legend &amp; Parties">
        <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1200" background="#021640" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="LegendParties_c_1" value="Core Mobile Wallet — Transaction Flow Diagrams: Legend &amp; Parties" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_2" value="Nine flows over ten pages. Node colour = which party acts. Edge colour = what moves. Dashed bands mark custody, Core fee points, and reduced-control windows.&lt;br&gt;Label prefix (f) = a fee or spread is taken at this step; (k) = private-key material is used at this step." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1500" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_3" value="(i)  PARTIES  —  node colour / swimlane" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="150" width="700" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_4" value="User / Device" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="184" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_5" value="The customer and the physical handset: taps, PIN entry, biometrics,&lt;br&gt;hardware-wallet buttons, camera." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="306" y="190" width="560" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_6" value="Core Mobile app (on device)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="254" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_7" value="Ava Labs&#39; client software running locally: balance &amp; fee calculation,&lt;br&gt;transaction construction, address derivation, local key store." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="306" y="260" width="560" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_8" value="Ava Labs backend" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#164E63;strokeColor=#22D3EE;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="324" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_9" value="Services operated by Ava Labs: the Core proxy (PROXY_URL), Glacier&lt;br&gt;indexer, token-aggregator API, Gas Station, core-seedless-api." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="306" y="330" width="560" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_10" value="Third-party service" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7C2D12;strokeColor=#FB923C;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="394" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_11" value="Independent providers outside Ava Labs&#39; control: Meld and its payment&lt;br&gt;providers, Markr, deBridge, Lombard, CubeSigner, Blockaid, dApps." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="306" y="400" width="560" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_12" value="Blockchain network" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="40" y="464" width="250" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_13" value="Public ledgers: Avalanche C-Chain / X-Chain / P-Chain, Bitcoin,&lt;br&gt;Solana, and EVM L1s. Settlement is final here." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="306" y="470" width="560" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_14" value="DASHED BANDS  —  three meanings, distinguished by colour and prefix" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="550" width="800" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_15" value="  (k) Key control boundary" style="rounded=1;html=1;fillColor=none;strokeColor=#F87171;dashed=1;strokeWidth=2;verticalAlign=top;align=left;fontColor=#FCA5A5;fontFamily=Verdana;fontSize=11;spacingLeft=8;spacingTop=2;dashPattern=8 8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="584" width="820" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_16" value="Where private-key material lives and where signing happens: on device for recovery-phrase&lt;br&gt;wallets, on the device itself for Ledger and Keystone, remotely in CubeSigner&#39;s HSM for&lt;br&gt;seedless wallets. Steps prefixed (k) touch key material." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="58" y="612" width="790" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_17" value="  (f) Core-owned fee escrow" style="rounded=1;html=1;fillColor=none;strokeColor=#FBBF24;dashed=1;strokeWidth=2;verticalAlign=top;align=left;fontColor=#FDE68A;fontFamily=Verdana;fontSize=11;spacingLeft=8;spacingTop=2;dashPattern=8 8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="704" width="820" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_18" value="A fee is paid to an address Ava Labs owns. Appears on ONE page only — Stake / Earn (page 6) —&lt;br&gt;and there only on the FAST STAKE path; the advanced delegate path charges no Core fee.&lt;br&gt;Everywhere else, fees go to networks, validators, or third-party providers." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="58" y="732" width="790" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_19" value="  !  Reduced user control" style="rounded=1;html=1;fillColor=none;strokeColor=#FDE047;dashed=1;strokeWidth=3;verticalAlign=top;align=left;fontColor=#FEF08A;fontFamily=Verdana;fontSize=11;spacingLeft=8;spacingTop=2;dashPattern=4 4;" parent="1" vertex="1">
                    <mxGeometry x="40" y="824" width="820" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_20" value="A window in which the customer does not control the asset, or in which no per-transaction&lt;br&gt;signature is taken. Three instances across the set: cross-chain swap (a bridge contract holds&lt;br&gt;the asset between legs, page 5); offramp (the provider holds the crypto before paying out,&lt;br&gt;page 8); recurring swap (a standing allowance lets Markr act without a signature, page 7)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="58" y="852" width="790" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_21" value="(ii)  WHAT MOVES  —  edge colour" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="900" y="150" width="640" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_22" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" vertex="1" parent="1">
                    <mxGeometry x="900" y="194" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_23" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="194" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_e_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#22C55E;strokeWidth=3;dashed=1;fontColor=#4ADE80;" edge="1" parent="1" source="LegendParties_c_22" target="LegendParties_c_23">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_25" value="Fiat currency" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="184" width="520" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_26" value="Government-issued money over card networks or bank rails.&lt;br&gt;Never passes through an Ava Labs or Core-controlled account." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="202" width="520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_27" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" vertex="1" parent="1">
                    <mxGeometry x="900" y="268" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_28" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="268" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_e_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#FB923C;strokeWidth=3;fontColor=#FDBA74;" edge="1" parent="1" source="LegendParties_c_27" target="LegendParties_c_28">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_30" value="Crypto asset" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="258" width="520" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_31" value="On-chain value: native coins, stablecoins, ERC-20s, NFTs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="276" width="520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_32" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" vertex="1" parent="1">
                    <mxGeometry x="900" y="342" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_33" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="342" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_e_34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" edge="1" parent="1" source="LegendParties_c_32" target="LegendParties_c_33">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_35" value="Data / control" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="332" width="520" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_36" value="Instructions, quotes, prices, addresses, status. Carries no value." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="350" width="520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_37" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="900" y="416" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_38" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="416" width="10" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_e_39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#F87171;strokeWidth=2;dashed=1;fontColor=#FCA5A5;" edge="1" parent="1" source="LegendParties_c_37" target="LegendParties_c_38">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_40" value="Key or signature" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="406" width="520" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_41" value="Private-key material or a signature produced from it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="1032" y="424" width="520" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_42" value="(iii)  CUSTODY &amp; KEY CONTROL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="900" y="496" width="640" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_43" value="Core takes custody of no customer asset and holds no customer fiat. Signing always happens&lt;br&gt;inside the red key control boundary, and assets settle to addresses the customer controls.&lt;br&gt;Continuous control carries FOUR qualifications — the three yellow bands above, plus the&lt;br&gt;staking lock-up. Seedless wallets are the one case where key material itself sits with a&lt;br&gt;third party (CubeSigner). See page 1 for the four custody models." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" vertex="1" parent="1">
                    <mxGeometry x="900" y="526" width="650" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_44" value="(iv)  THIRD-PARTY PROVIDERS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="626" width="640" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_45" value="Every orange node names the provider and, where relevant, the customer data it receives&lt;br&gt;(wallet address, amount, KYC identity, bank details). Providers reached through the Core&lt;br&gt;proxy are drawn behind an Ava Labs infra node to show the app does not call them directly.&lt;br&gt;KYC is always performed by the provider, never by Core." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" vertex="1" parent="1">
                    <mxGeometry x="900" y="656" width="650" height="74" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_46" value="(v)  FEES" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=14;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="900" y="742" width="640" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_47" value="Steps prefixed (f) mark where a fee or spread is taken; each page lists every component and&lt;br&gt;who receives it. Core charges an explicit fee in ONE place only — the FAST STAKE convenience&lt;br&gt;fee (page 6), paid to a Core-owned P-Chain escrow at a rate supplied as a PostHog variant.&lt;br&gt;Elsewhere the mandatory cost is the network fee, paid to validators or miners. Where a&lt;br&gt;commercial arrangement is not observable in client code, the page says so rather than guess." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" vertex="1" parent="1">
                    <mxGeometry x="900" y="772" width="650" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_48" value="PAGE INDEX&lt;br&gt;&lt;br&gt;0   Legend &amp; Parties — this page&lt;br&gt;1   Onboarding — establishing custody (no assets move)&lt;br&gt;2   Receive — inbound crypto and stablecoins&lt;br&gt;3   Send — outbound transfer of crypto and stablecoins&lt;br&gt;4   Buy — fiat currency to crypto (on-ramp)&lt;br&gt;5   Swap — crypto to crypto, same-chain and cross-chain&lt;br&gt;6   Stake / Earn — P-Chain delegation&lt;br&gt;7   Recurring swap — scheduled / DCA orders&lt;br&gt;8   Offramp — crypto to fiat currency (sell / withdraw)&lt;br&gt;9   dApp signing — in-app browser and WalletConnect" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#0B2545;strokeColor=#64748B;fontColor=#E2E8F0;fontFamily=Verdana;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="40" y="964" width="700" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="LegendParties_c_50" value="WHAT HOLDS ACROSS THE WHOLE WALLET  —  read this before the individual pages&lt;br&gt;&lt;br&gt;1.  Core never holds customer fiat. On both the on-ramp and the off-ramp, fiat stays inside the licensed provider&#39;s environment.&lt;br&gt;2.  Core never takes custody of customer crypto, and cannot sign on a customer&#39;s behalf — except that for SEEDLESS wallets the key&lt;br&gt;     material sits in CubeSigner&#39;s HSM rather than on the handset, so signing there is remote and MFA-gated.&lt;br&gt;3.  Continuous user control has four qualifications: a bridge holds the asset mid cross-chain swap (5); the offramp provider holds it&lt;br&gt;     before paying out (8); a standing allowance lets Markr execute recurring orders unsigned (7); a stake is locked for its full term (6).&lt;br&gt;4.  Core charges an explicit fee in one place only — the FAST STAKE path of Stake / Earn (6), paid to a Core-owned P-Chain escrow&lt;br&gt;     address. The advanced delegate path charges none. Send, Receive, Buy, Offramp, Swap and dApp signing apply no Core service&lt;br&gt;     fee in the client code, though Buy, Offramp and Swap each involve third-party partner-fee mechanisms whose commercial&lt;br&gt;     terms are not visible in the client.&lt;br&gt;5.  Every dApp transaction requires explicit approval: the Quick Swaps auto-approve bypass is gated on an in-app request and a&lt;br&gt;     software wallet type, so it is structurally unreachable from a dApp or WalletConnect request." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#0B2545;strokeColor=#64748B;fontColor=#E2E8F0;fontFamily=Verdana;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
                    <mxGeometry x="781" y="964" width="700" height="250" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="pg_1._Onboarding" name="1. Onboarding">
        <mxGraphModel dx="2179" dy="931" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" background="#021640" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="1Onboarding_c_1" value="1. Onboarding — establishing custody" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="1Onboarding_c_2" value="No assets move during onboarding. This flow decides WHO HOLDS THE KEYS for every later transaction, so it is the reference for item (iii) on all other pages.&lt;br&gt;Organised by wallet type rather than by party; node colour still identifies the party." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1500" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="1Onboarding_c_3" value="Launch Core Mobile&lt;br&gt;(no wallet present)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#E2E8F0;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="94" y="138" width="230" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="1Onboarding_c_4" value="Accept Terms of Use&lt;br&gt;and Privacy Policy" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
