                </mxCell>
                <mxCell id="4Buyfiatonramp_e_54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="4Buyfiatonramp_c_47" target="4Buyfiatonramp_c_53" edge="1">
