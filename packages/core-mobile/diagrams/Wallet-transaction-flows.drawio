                <mxCell id="5Swap_c_6" value="Token-aggregator API supplies&lt;br&gt;prices and token metadata" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#164E63;strokeColor=#22D3EE;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="677" y="440" width="262" height="64" as="geometry"/>
