                </mxCell>
                <mxCell id="6StakeEarn_e_38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Verdana;fontSize=10;labelBackgroundColor=#021640;strokeColor=#94A3B8;strokeWidth=1;fontColor=#CBD5E1;" parent="1" source="6StakeEarn_c_11" target="6StakeEarn_c_12" edge="1">
