                <mxCell id="3Send_c_1" value="3. Send — outbound transfer of crypto and stablecoins" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
