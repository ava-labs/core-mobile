                <mxCell id="9dApptransactionsigning_c_1" value="9. In-app browser and WalletConnect — third-party dApp transaction signing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Verdana;fontSize=17;fontColor=#FFFFFF;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="24" width="1400" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_2" value="The widest risk surface in the wallet: the transaction is authored by an arbitrary third party, not by Core. Every dApp request reaches an explicit approval screen — the Quick Swaps auto-approve bypass is structurally unavailable here." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;fontColor=#94A3B8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="56" width="1500" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_3" value="Open a site in the in-app browser&lt;br&gt;(or scan a WalletConnect QR)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#E2E8F0;fontColor=#FFFFFF;fontFamily=Verdana;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="63" y="190" width="250" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_4" value="Core injects a window.ethereum shim into&lt;br&gt;the WebView (EIP-1193 + EIP-6963)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="280" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_5" value="dApp requests accounts&lt;br&gt;(eth_requestAccounts)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7C2D12;strokeColor=#FB923C;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="987" y="370" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_6" value="postMessage bridge hands the request to&lt;br&gt;the native RPC handler" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="450" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_7" value="WalletConnect path only: Blockaid scans&lt;br&gt;the dApp URL (feature-flag gated)" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#164E63;strokeColor=#22D3EE;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="677" y="530" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_8" value="Connect approval screen — the user&lt;br&gt;authorises this specific site" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="57" y="610" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_9" value="accountsChanged is emitted only now:&lt;br&gt;addresses are NEVER pre-seeded&lt;br&gt;into the injected shim" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="690" width="262" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_10" value="dApp requests a signing method —&lt;br&gt;eth_sendTransaction, personal_sign,&lt;br&gt;eth_signTypedData, avalanche_*,&lt;br&gt;solana_*, bitcoin_*" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7C2D12;strokeColor=#FB923C;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="987" y="780" width="262" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_11" value="Namespace filter: a cross-namespace&lt;br&gt;method cannot route into another VM&#39;s&lt;br&gt;signing path" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="880" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_12" value="ApprovalController.requestApproval —&lt;br&gt;the Quick Swaps auto-approve bypass is&lt;br&gt;UNAVAILABLE to dApp requests" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="970" width="262" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_13" value="(k) Review the decoded transaction and&lt;br&gt;approve with PIN or biometrics" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#2D5FA8;strokeColor=#8AB4F8;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="57" y="1060" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_14" value="(k) WalletService signs — single request,&lt;br&gt;or BatchApprovalScreen for&lt;br&gt;eth_sendTransactionBatch" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#7F1D1D;strokeColor=#F87171;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="1150" width="262" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_15" value="(f) Transaction settles; network fee paid.&lt;br&gt;Any contract-level fee is set by the&lt;br&gt;dApp, not by Core" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#4C1D6B;strokeColor=#C084FC;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="1297" y="1240" width="262" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_16" value="Result returned to the dApp via&lt;br&gt;__coreProviderRespond" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
                    <mxGeometry x="367" y="1330" width="262" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="9dApptransactionsigning_c_17" value="A cross-origin navigation aborts any&lt;br&gt;approval request still parked" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Verdana;fontSize=11;verticalAlign=middle;fillColor=#14532D;strokeColor=#4ADE80;fontColor=#FFFFFF;" parent="1" vertex="1">
